{
  "manifest_version": 3,
  "name": "Habblaud Conversas",
  "version": "0.1.2",
  "description": "Mostra suas conversas do ChatGPT, Claude, Gemini e Muse como personagens no escritório do Habblaud. Envia só status e título, nunca o conteúdo.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://muse.ai/*",
    "https://*.muse.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Habblaud Conversas",
    "default_popup": "popup.html"
  }
}
